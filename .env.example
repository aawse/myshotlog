# All Git/auth variables are SERVER-ONLY. Never prefix tokens or accounts with NEXT_PUBLIC_.
GIT_DATABASE_PROVIDER=github
GIT_DATABASE_REPOSITORY=YOUR_OWNER/YOUR_PRIVATE_DATA_REPO
GIT_DATABASE_BRANCH=main
GIT_DATABASE_PREFIX=myshotlog/v1
GIT_DATABASE_TOKEN=YOUR_REPOSITORY_SCOPED_TOKEN
GIT_DATABASE_API_URL=https://api.github.com
# Per-instance read cache lifetime (0 disables, max 300 seconds). Writes stay fresh.
GIT_DATABASE_READ_CACHE_SECONDS=15

# Alternative: local bare repository or SSH/HTTPS Git remote. Requires a Git executable.
# GIT_DATABASE_PROVIDER=git
# GIT_DATABASE_REMOTE=/absolute/path/to/myshotlog-data.git
# GIT_DATABASE_REMOTE=git@YOUR_GIT_HOST:YOUR_OWNER/YOUR_PRIVATE_DATA_REPO.git

# Register a GitHub OAuth app; callback: https://YOUR_SITE/auth/github/callback/
GITHUB_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
# Comma-separated immutable numeric GitHub user IDs allowed to sign in.
GITHUB_ALLOWED_USER_IDS=YOUR_GITHUB_NUMERIC_USER_ID
# Optional migration: map a GitHub ID to its existing journal UUID. Each UUID must be unique.
# GITHUB_USER_ID_MAP={"123456":"YOUR_EXISTING_JOURNAL_UUID"}
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_BYTES
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted reverse proxy only: set after configuring the proxy to REPLACE this header.
# Direct clients must never be able to supply the trusted value. Vercel needs no setting.
# AUTH_TRUSTED_IP_HEADER=x-real-ip

# Optional app updates: a SEPARATE token restricted to your CODE fork only.
# Grant Contents and Workflows: Read and write. Configure in Vercel Production only.
# GITHUB_CODE_TOKEN=YOUR_CODE_FORK_SCOPED_TOKEN
# Vercel Git metadata identifies the code fork automatically. Overrides for other hosts:
# GITHUB_CODE_REPOSITORY=YOUR_OWNER/YOUR_CODE_FORK
# GITHUB_CODE_BRANCH=main
# Optional organization/admin override: allowed numeric GitHub IDs. Defaults to fork owner.
# GITHUB_UPDATE_ADMIN_IDS=YOUR_GITHUB_NUMERIC_USER_ID
