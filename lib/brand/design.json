{
  "font": {
    "family": "Didact Gothic",
    "file": "DidactGothic-Regular.ttf",
    "variable": "--font-didact-gothic",
    "webFile": "DidactGothic-Regular.woff2"
  },
  "colours": {
    "background": "#f4f4ee",
    "ink": "#1c2d25",
    "muted": "#606c63",
    "line": "#d8ded5",
    "green": "#244d3d",
    "pale": "#e7ede4",
    "gold": "#bc9864",
    "surface": "#fefefa",
    "white": "#ffffff",
    "danger": "#a44736",
    "medalGold": "#c59616",
    "medalSilver": "#a4afb9",
    "medalBronze": "#a65f38"
  },
  "radius": {
    "control": 8,
    "panel": 8,
