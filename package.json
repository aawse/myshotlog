{
  "name": "myshotlog",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "rules:check": "vitest run tests/catalog.test.ts tests/rules.test.ts",
    "rules:sync": "npm run rules:check && node scripts/sync-rules.mjs",
    "format": "prettier --write app components lib tests scripts \"*.ts\" \"*.json\"",
    "format:check": "prettier --check app components lib tests scripts \"*.ts\" \"*.json\"",
    "setup:local": "node scripts/setup-local.mjs",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install --with-deps chromium firefox webkit",
    "test:ui:repeat": "node scripts/repeat-ui.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
